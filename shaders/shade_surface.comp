#version 450
// Shade each queued hit. A light adds its radiance (MIS-weighted against the
// light sample the previous vertex took) and ends the path. A surface takes one
// light sample (a shadow ray in the path's own slot) and one BSDF sample, then
// continues or ends by Russian roulette and the bounce limit.
//
// Materials are OpenPBR (shaders/openpbr.glsl).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "common.glsl"
#include "sampler.glsl"
#include "spectrum.glsl"
#include "lights.glsl"
#include "microfacet.glsl"
#include "openpbr.glsl"

vec3 point_of(uint index) {
    return vec3(positions[index * 3u], positions[index * 3u + 1u], positions[index * 3u + 2u]);
}

void main() {
    uint at = gl_GlobalInvocationID.x;
    if (at >= queue_count(Q_SURFACE)) return;
    uint path = queue_path(Q_SURFACE, at);
    uint pixel = get_u(SU_PIXEL, path);
    uint bounce = get_u(SU_BOUNCE, path);
    vec4 hit = get_v(SV_HIT, path);
    vec3 origin = get_v(SV_ORIGIN, path).xyz;
    vec4 ray = get_v(SV_DIRECTION, path);
    Spec throughput = get_v(SV_THROUGHPUT, path);
    vec4 lambda = get_v(SV_LAMBDA, path);
    uint what = get_u(SU_HIT, path);

    if ((what & LIGHT_HIT) != 0u) {
        uint light = what & ~LIGHT_HIT;
        float weight = 1.0;
        if (bounce == 0u) {
            if (!light_visible(light)) return;
        } else if (ray.w > 0.0) {
            weight = power_heuristic(ray.w, light_hit_pdf(light, origin, ray.xyz, hit.x));
        }
        set_v(SV_RADIANCE, path, get_v(SV_RADIANCE, path) + throughput * light_radiance(light, lambda) * weight);
        return;
    }

    // A surface reached past the bounce limit ends the path. The ray that got
    // here was still traced, so its light hits (and their MIS weights) count.
    if (bounce >= uint(constants[K_INFO].y)) return;

    uint triangle = what;
    vec3 p0 = point_of(indices[triangle * 3u]);
    vec3 geometric = normalize(cross(point_of(indices[triangle * 3u + 1u]) - p0, point_of(indices[triangle * 3u + 2u]) - p0));
    if (dot(geometric, ray.xyz) > 0.0) geometric = -geometric;
    uvec4 attributes = shading[triangle];
    vec3 normal = normalize((1.0 - hit.z - hit.w) * octahedral_decode(attributes.x) + hit.z * octahedral_decode(attributes.y) + hit.w * octahedral_decode(attributes.z));
    if (dot(normal, geometric) < 0.0) normal = -normal;
    vec3 p = origin + hit.x * ray.xyz;
    vec3 from = offset_origin(p, geometric);
    Surface surface;
    surface.normal = normal;
    basis(normal, surface.tangent, surface.bitangent);
    surface.geometric = geometric;
    surface.material = attributes.w;
    vec3 wo = to_local(surface, -ray.xyz);
    prepare_surface(surface, wo, lambda);

    // Emission: surfaces are not light-sampled yet, so it takes no MIS weight.
    if (material_at(attributes.w, 7u).w > 0.0) {
        set_v(SV_RADIANCE, path, get_v(SV_RADIANCE, path) + throughput * material_color(attributes.w, 6u, lambda));
    }

    // One light sample.
    uint lights_count = uint(constants[K_INFO].x);
    if (lights_count > 0u) {
        vec4 u = sample4(pixel, params.sample_index, GROUP_LIGHT(bounce));
        float select_pdf;
        uint light = pick_light(u.x, select_pdf);
        LightSample s;
        if (select_pdf > 0.0 && sample_light(light, p, u.yz, s) && dot(s.direction, geometric) > 0.0) {
            vec3 wi = to_local(surface, s.direction);
            float bsdf_pdf;
            Spec f = evaluate_surface(surface, wi, wo, bsdf_pdf);
            if (bsdf_pdf > 0.0) {
                float light_pdf = s.pdf * select_pdf;
                float weight = s.delta ? 1.0 : power_heuristic(light_pdf, bsdf_pdf);
                Spec contribution = throughput * f * wi.z * light_radiance(light, lambda) * (weight / light_pdf);
                float reach = s.distance >= INFINITY ? INFINITY : s.distance * (1.0 - 1e-4);
                set_v(SV_SHADOW_ORIGIN, path, vec4(from, reach));
                set_v(SV_SHADOW_DIRECTION, path, vec4(s.direction, 0.0));
                set_v(SV_SHADOW_RADIANCE, path, contribution);
                queue_push(Q_SHADOW, path);
            }
        }
    }

    // One BSDF sample.
    vec4 u = sample4(pixel, params.sample_index, GROUP_BSDF(bounce));
    vec3 wi;
    Spec weight;
    float pdf;
    if (!sample_surface(surface, wo, u.xyw, wi, weight, pdf)) return;
    vec3 direction = to_world(surface, wi);
    // A shading normal can send a reflection under the true surface.
    if (dot(direction, geometric) <= 0.0) return;
    throughput *= weight;
    bounce += 1u;
    if (bounce >= 3u) {
        float survive = min(0.95, spec_max(throughput));
        if (u.z >= survive) return;
        throughput /= survive;
    }
    set_u(SU_BOUNCE, path, bounce);
    set_v(SV_ORIGIN, path, vec4(from, 0.0));
    set_v(SV_DIRECTION, path, vec4(direction, pdf));
    set_v(SV_THROUGHPUT, path, throughput);
    queue_push(Q_CLOSEST + 1u - params.current, path);
}
