#version 450
// One thread between kernels: turn a queue's count into indirect dispatch
// arguments (groups of 64) and clear the queues the next kernels fill, so the
// host never reads counts back.
//   phase 0, before intersect_closest: closest[current]; clears surface, miss, shadow
//   phase 1, before shading: surface and miss; clears closest[1 - current]
//   phase 2, before intersect_shadow: shadow
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 1) in;
#include "common.glsl"

void arguments(uint queue) {
    uint at = 16u + 3u * queue;
    queues[at] = (queues[queue] + 63u) / 64u;
    queues[at + 1u] = 1u;
    queues[at + 2u] = 1u;
}

void main() {
    if (params.phase == 0u) {
        arguments(Q_CLOSEST + params.current);
        queues[Q_SURFACE] = 0u;
        queues[Q_MISS] = 0u;
        queues[Q_SHADOW] = 0u;
    } else if (params.phase == 1u) {
        arguments(Q_SURFACE);
        arguments(Q_MISS);
        queues[Q_CLOSEST + 1u - params.current] = 0u;
    } else {
        arguments(Q_SHADOW);
    }
}
