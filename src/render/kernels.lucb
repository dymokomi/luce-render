n    float positions[1];\n};\n\nstruct Indices\n{\n    uint indices[1];\n};\n\nstruct Lights\n{\n    float4 lights[1];\n};\n\nstruct StateV\n{\n    float4 state_v[1];\n};\n\nstruct StateU\n{\n    uint state_u[1];\n};\n\nstruct Queues\n{\n    uint queues[1];\n};\n\nstatic inline __attribute__((always_inline))\nuint film_pixels(constant Params& params)\n{\n    return uint(params.du.w) * uint(params.dv.w);\n}\n\nstatic inline __attribute__((always_inline))\nfloat4 film_at(thread const uint& plane, thread const uint& pixel, constant Params& params, device Film& _39)\n{\n    return _39.film[(plane * film_pixels(params)) + pixel];\n}\n\nkernel void luce_compute(constant Params& params [[buffer(30)]], device Film& _39 [[buffer(7)]], device Constants& _170 [[buffer(9)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])\n{\n    uint width = uint(params.du.w);\n    uint height = uint(params.dv.w);\n    uint2 at = gl_GlobalInvocationID.xy;\n    bool _72 = at.x >= width;\n    bool _81;\n    if (!_72)\n    {\n        _81 = at.y >= height;\n    }\n    else\n    {\n        _81 = _72;\n    }\n    if (_81)\n    {\n        return;\n    }\n    uint pixel = (at.y * width) + at.x;\n    if (params.phase == 0u)\n    {\n        uint param = 0u;\n        uint param_1 = pixel;\n        float4 sum = film_at(param, param_1, params, _39);\n        uint param_2 = 1u;\n        uint param_3 = pixel;\n        float4 half_sum = film_at(param_2, param_3, params, _39);\n        float scale = 1.0 / fast::max(sum.w, 1.0);\n        float difference = ((abs(sum.x - half_sum.x) + abs(sum.y - half_sum.y)) + abs(sum.z - half_sum.z)) * scale;\n        float brightness = fast::max(0.0, ((sum.x + sum.y) + sum.z) * scale);\n        float error = difference / (9.9999997473787516355514526367188e-05 + sqrt(brightness));\n        _39.film[(2u * film_pixels(params)) + pixel] = float4(float(error < ((device float*)&_170.constants[11])[0u]), 0.0, 0.0, 0.0);\n        return;\n    }\n    float converged = 1.0;\n 