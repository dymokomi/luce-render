pub let film_convert_rgb_comp_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 position;\n    float4 corner;\n    float4 du;\n    float4 dv;\n    uint band_start;\n    uint band_count;\n    uint sample_index;\n    uint bounce;\n    uint current;\n    uint phase;\n    uint pool;\n    uint seed;\n};\n\nstruct Film\n{\n    float4 film[1];\n};\n\nconstant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(8u, 8u, 1u);\n\nstruct Node\n{\n    float3 lo;\n    uint first;\n    float3 hi;\n    uint count;\n};\n\nstruct Nodes\n{\n    Node nodes[1];\n};\n\nstruct Positions\n{\n    float positions[1];\n};\n\nstruct Indices\n{\n    uint indices[1];\n};\n\nstruct Lights\n{\n    float4 lights[1];\n};\n\nstruct StateV\n{\n    float4 state_v[1];\n};\n\nstruct StateU\n{\n    uint state_u[1];\n};\n\nstruct Queues\n{\n    uint queues[1];\n};\n\nstruct Constants\n{\n    float4 constants[1];\n};\n\nkernel void luce_compute(constant Params& params [[buffer(30)]], const device Film& _57 [[buffer(7)]], texture2d<float, access::write> image [[texture(8)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])\n{\n    uint width = uint(params.du.w);\n    uint height = uint(params.dv.w);\n    uint2 at = gl_GlobalInvocationID.xy;\n    bool _39 = at.x >= width;\n    bool _48;\n    if (!_39)\n    {\n        _48 = at.y >= height;\n    }\n    else\n    {\n        _48 = _39;\n    }\n    if (_48)\n    {\n        return;\n    }\n    float4 sum = _57.film[(at.y * width) + at.x];\n    float3 value = sum.xyz / float3(fast::max(sum.w, 1.0));\n    image.write(float4(value, 1.0), uint2(int2(at)));\n}\n\n"
