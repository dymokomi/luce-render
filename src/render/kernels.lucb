int pixel = get_u(param, param_1, params, _52);\n    uint param_2 = 3u;\n    uint param_3 = path;\n    uint param_4 = 4u;\n    uint param_5 = path;\n    float4 param_6 = get_v(param_2, param_3, _30, params);\n    float4 param_7 = get_v(param_4, param_5, _30, params);\n    float3 value = spec_to_film(param_6, param_7);\n    bool _108 = any(isnan(value));\n    bool _115;\n    if (!_108)\n    {\n        _115 = any(isinf(value));\n    }\n    else\n    {\n        _115 = _108;\n    }\n    if (_115)\n    {\n        value = float3(0.0);\n    }\n    _123.film[pixel] += float4(value, 1.0);\n}\n\n"
