pub let schedule_comp_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Queues\n{\n    uint queues[1];\n};\n\nstruct Params\n{\n    float4 position;\n    float4 corner;\n    float4 du;\n    float4 dv;\n    uint band_start;\n    uint band_count;\n    uint sample_index;\n    uint bounce;\n    uint current;\n    uint phase;\n    uint pool;\n    uint seed;\n};\n\nconstant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(1u);\n\nstruct Node\n{\n    float3 lo;\n    uint first;\n    float3 hi;\n    uint count;\n};\n\nstruct Nodes\n{\n    Node nodes[1];\n};\n\nstruct Positions\n{\n    float positions[1];\n};\n\nstruct Indices\n{\n    uint indices[1];\n};\n\nstruct Lights\n{\n    float4 lights[1];\n};\n\nstruct StateV\n{\n    float4 state_v[1];\n};\n\nstruct StateU\n{\n    uint state_u[1];\n};\n\nstruct Film\n{\n    float4 film[1];\n};\n\nstruct Constants\n{\n    float4 constants[1];\n};\n\nstatic inline __attribute__((always_inline))\nvoid arguments(thread const uint& queue, device Queues& _21)\n{\n    uint at = 16u + (3u * queue);\n    _21.queues[at] = (_21.queues[queue] + 63u) / 64u;\n    _21.queues[at + 1u] = 1u;\n    _21.queues[at + 2u] = 1u;\n}\n\nkernel void luce_compute(constant Params& params [[buffer(30)]], device Queues& _21 [[buffer(6)]])\n{\n    if (params.phase == 0u)\n    {\n        uint param = 0u + params.current;\n        arguments(param, _21);\n        _21.queues[2] = 0u;\n        _21.queues[3] = 0u;\n        _21.queues[4] = 0u;\n    }\n    else\n    {\n        if (params.phase == 1u)\n        {\n            uint param_1 = 2u;\n            arguments(param_1, _21);\n            uint param_2 = 3u;\n            arguments(param_2, _21);\n            _21.queues[1u - params.current] = 0u;\n        }\n        else\n        {\n            uint param_3 = 4u;\n            arguments(param_3, _21);\n        }\n    }\n}\n\n"
